# Copy to .env and fill in. Never commit .env.

# ---- Database ----
POSTGRES_USER=recipes
POSTGRES_PASSWORD=change-me
POSTGRES_DB=recipes
# Host port for the dev container. Defaults to 5433 rather than 5432 so this can
# run alongside another local Postgres without a port clash.
POSTGRES_PORT=5433
DATABASE_URL=postgresql://recipes:change-me@localhost:5433/recipes

# ---- Auth ----
# Signing secret for the httpOnly JWT cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---- Encryption for household-supplied secrets ----
# AES-256-GCM key used ONLY to encrypt each household's Anthropic API key at rest.
# Exactly 32 bytes, base64-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# WARNING: rotating this value makes every stored household API key undecryptable.
# Each household must then re-enter its key in Settings.
AI_ENCRYPTION_KEY=

# ---- App ----
NODE_ENV=development
# Defaults chosen to avoid clashing with another local Node app.
PORT=3001
FRONTEND_URL=http://localhost:4201

# Bootstraps/guarantees an ADMIN account on every startup. Optional.
ADMIN_USER_ID=

# NOTE: there is deliberately no ANTHROPIC_API_KEY here.
# AI suggestions use a bring-your-own key configured per household in Settings,
# stored encrypted with AI_ENCRYPTION_KEY above.
