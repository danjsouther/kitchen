{
  "compilerOptions": {
    // nodenext is required by the generated Prisma client, which emits relative
    // imports carrying explicit .ts extensions; nodenext rewrites them on emit.
    // Classic "commonjs" resolution leaves them as-is and the built output then
    // fails at runtime with MODULE_NOT_FOUND.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    // No baseUrl: deprecated in TypeScript 6, removed in 7, and nothing here
    // used it — there are no "paths" mappings.
    "incremental": true,
    "skipLibCheck": true,
    // Named explicitly because TypeScript 6 only auto-includes the *nearest*
    // node_modules/@types, and npm hoists @types/jest to the workspace root
    // while leaving a nested @types/node here. Without this, every spec file
    // fails with "Cannot find name 'describe'".
    "types": ["node", "jest"],
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true
  },
  "exclude": ["node_modules", "dist"]
}
