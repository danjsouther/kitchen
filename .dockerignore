# Keeps the build context small, but more importantly keeps host state out of
# the image. `COPY packages/backend packages/backend` would otherwise drop a
# host-built node_modules and dist on top of what `npm ci` just installed —
# including native binaries compiled for the host OS rather than the container.
node_modules
**/node_modules

# Build output. Rebuilt inside the image; copying it in risks shipping a stale
# bundle that silently disagrees with the source next to it.
dist
**/dist
.angular
**/.angular
*.tsbuildinfo
**/*.tsbuildinfo
out-tsc
**/out-tsc

# Generated Prisma client — regenerated in the builder stage by design, so that
# the query engine matches the container's platform and not the host's.
packages/backend/generated

# Secrets. docker-compose mounts .env at runtime; it must never be baked into
# an image layer, where it would persist even if a later layer deleted it.
.env
.env.local
.env.*.local

# The Open Food Facts dump — ~12 GB of gzipped JSONL that `npm run off:download`
# drops here. It is git-ignored, so it is invisible until a build tries to copy
# it and dies with "no space left on device". Nothing in the image reads it:
# `off:import` is run by hand against a host path, and the small fixtures used by
# tests and the seed live in packages/backend/prisma/seed/off-fixtures instead.
packages/backend/data
**/data/off

# Local-only and irrelevant to a build.
.git
.gitignore
.gitattributes
.github
.claude
.vscode
.idea
.playwright-mcp
uploads
**/uploads
*.log
npm-debug.log*
Dockerfile
**/Dockerfile
docker-compose*.yml
README.md
CHANGELOG.md
docs/
